#!/usr/bin/env bash

# ============================================================
# DOTFILES INSTALLER - FEDORA
# ============================================================
#
# Fresh install:
#
#   sudo dnf install -y git
#
#   git clone https://github.com/b4kii/dotfiles.git ~/.dotfiles
#   cd ~/.dotfiles
#   chmod +x install.sh
#   ./install.sh
#
# IMPORTANT:
#   - Do NOT run this script with sudo.
#   - The script will ask for sudo only when needed.
#   - Existing configs are backed up before symlinks are created.
#
# After installation:
#   1. Log out.
#   2. Select Sway in GDM.
#   3. Log in again.
#
# Reload Sway config:
#
#   swaymsg reload
#
# Yazi with cwd change after exit:
#
#   y
#
# ============================================================

set -Eeuo pipefail

REPO_URL="https://github.com/b4kii/dotfiles.git"
FALLBACK_DOTFILES_DIR="$HOME/.dotfiles"
BACKUP_ROOT="$HOME/.dotfiles-backup/$(date +%Y%m%d-%H%M%S)"

log()  { printf '\n\033[1;34m==>\033[0m %s\n' "$*"; }
ok()   { printf '\033[1;32m[OK]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[WARN]\033[0m %s\n' "$*"; }
die()  { printf '\033[1;31m[ERROR]\033[0m %s\n' "$*" >&2; exit 1; }

# ============================================================
# SAFETY / FEDORA
# ============================================================

[[ -f /etc/fedora-release ]] || die "Ten installer jest przygotowany dla Fedory."

if [[ ${EUID:-$(id -u)} -eq 0 ]]; then
  die "Uruchom skrypt jako zwykly uzytkownik, nie przez sudo."
fi

log "Sprawdzam sudo"
sudo -v

# ============================================================
# BASE / CLI / YAZI DEPENDENCIES
# ============================================================

log "Instaluje podstawowe pakiety i narzedzia CLI"

sudo dnf install -y \
  git \
  curl \
  zsh \
  util-linux-user \
  fzf \
  neovim \
  file \
  ffmpeg-free \
  7zip \
  jq \
  poppler-utils \
  fd-find \
  ripgrep \
  zoxide \
  ImageMagick \
  wl-clipboard

# DNF5 uses dnf5-plugins for `dnf copr`.
if ! dnf copr --help >/dev/null 2>&1; then
  log "Instaluje obsluge COPR"
  sudo dnf install -y dnf5-plugins || sudo dnf install -y dnf-plugins-core
fi

# ============================================================
# SWAY DESKTOP STACK
# ============================================================

log "Instaluje Sway i desktopowy stack"

sudo dnf install -y \
  sway \
  sway-config-fedora \
  waybar \
  swaybg \
  swayidle \
  swaylock \
  rofi \
  copyq \
  dex \
  network-manager-applet \
  xdg-desktop-portal \
  xdg-desktop-portal-wlr \
  xdg-desktop-portal-gtk \
  grim \
  slurp \
  swappy \
  brightnessctl \
  playerctl \
  pavucontrol

# Fedora 44+ ma Wayland backend w zwyklym pakiecie rofi.
# CopyQ jest uruchamiany przez config Sway.
# sway-config-fedora zapewnia sesje Sway dla display managera.

# ============================================================
# WEZTERM
# ============================================================

if ! command -v wezterm >/dev/null 2>&1; then
  log "Instaluje WezTerm"
  sudo dnf copr enable -y wezfurlong/wezterm-nightly
  sudo dnf install -y wezterm
else
  ok "WezTerm juz jest zainstalowany"
fi

# ============================================================
# YAZI
# ============================================================

if ! command -v yazi >/dev/null 2>&1; then
  log "Instaluje Yazi"
  sudo dnf copr enable -y lihaohong/yazi
  sudo dnf install -y yazi
else
  ok "Yazi juz jest zainstalowane"
fi

# ============================================================
# LAZYGIT
# ============================================================

if ! command -v lazygit >/dev/null 2>&1; then
  log "Instaluje Lazygit"

  if ! sudo dnf install -y lazygit; then
    warn "Lazygit nie jest dostepny w aktywnych repo - wlaczam COPR dejan/lazygit"
    sudo dnf copr enable -y dejan/lazygit
    sudo dnf install -y lazygit
  fi
else
  ok "Lazygit juz jest zainstalowany"
fi

# ============================================================
# LOCATE / CLONE DOTFILES
# ============================================================

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

if [[ -f "$SCRIPT_DIR/zsh/.zshrc" && -f "$SCRIPT_DIR/wezterm/.wezterm.lua" ]]; then
  DOTFILES_DIR="$SCRIPT_DIR"
  ok "Uzywam repo: $DOTFILES_DIR"
else
  DOTFILES_DIR="$FALLBACK_DOTFILES_DIR"

  if [[ -d "$DOTFILES_DIR/.git" ]]; then
    log "Aktualizuje $DOTFILES_DIR"
    git -C "$DOTFILES_DIR" pull --ff-only
  else
    log "Klonuje dotfiles do $DOTFILES_DIR"
    git clone "$REPO_URL" "$DOTFILES_DIR"
  fi
fi

# ============================================================
# OH MY ZSH
# ============================================================

log "Konfiguruje Zsh / Oh My Zsh"

if [[ ! -f "$HOME/.oh-my-zsh/oh-my-zsh.sh" ]]; then
  if [[ -e "$HOME/.oh-my-zsh" ]]; then
    warn "~/.oh-my-zsh istnieje, ale wyglada na niekompletne - robie backup"
    mkdir -p "$BACKUP_ROOT"
    mv "$HOME/.oh-my-zsh" "$BACKUP_ROOT/oh-my-zsh"
  fi

  git clone --depth=1 \
    https://github.com/ohmyzsh/ohmyzsh.git \
    "$HOME/.oh-my-zsh"
else
  ok "Oh My Zsh juz jest zainstalowane"
fi

ZSH_CUSTOM="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}"
AUTOSUGGESTIONS_DIR="$ZSH_CUSTOM/plugins/zsh-autosuggestions"

if [[ ! -d "$AUTOSUGGESTIONS_DIR/.git" ]]; then
  log "Instaluje zsh-autosuggestions"

  rm -rf "$AUTOSUGGESTIONS_DIR"
  git clone --depth=1 \
    https://github.com/zsh-users/zsh-autosuggestions \
    "$AUTOSUGGESTIONS_DIR"
else
  ok "zsh-autosuggestions juz jest zainstalowane"
fi

# ============================================================
# YAZI SHELL WRAPPER
# ============================================================

log "Dodaje wrapper 'y' dla Yazi"

mkdir -p "$ZSH_CUSTOM"

cat > "$ZSH_CUSTOM/yazi.zsh" <<'EOF'
# Installed by b4kii/dotfiles install.sh.
# `y` opens Yazi and changes the shell directory to the directory
# in which Yazi was closed.
function y() {
  local tmp cwd

  tmp="$(mktemp -t 'yazi-cwd.XXXXXX')" || return

  yazi "$@" --cwd-file="$tmp"

  if cwd="$(command cat -- "$tmp")" \
    && [ -n "$cwd" ] \
    && [ "$cwd" != "$PWD" ]; then
    builtin cd -- "$cwd"
  fi

  rm -f -- "$tmp"
}
EOF

# ============================================================
# CONFIG LINKING WITH BACKUPS
# ============================================================

backup_and_link() {
  local source="$1"
  local target="$2"
  local relative

  [[ -e "$source" ]] || {
    warn "Brak pliku w repo, pomijam: $source"
    return
  }

  mkdir -p "$(dirname "$target")"

  if [[ -L "$target" ]] \
    && [[ "$(readlink -f "$target" 2>/dev/null || true)" == "$(readlink -f "$source")" ]]; then
    ok "$target juz wskazuje na dotfiles"
    return
  fi

  if [[ -e "$target" || -L "$target" ]]; then
    relative="${target#"$HOME"/}"
    mkdir -p "$BACKUP_ROOT/$(dirname "$relative")"
    mv "$target" "$BACKUP_ROOT/$relative"
    warn "Backup: $target -> $BACKUP_ROOT/$relative"
  fi

  ln -s "$source" "$target"
  ok "$target -> $source"
}

log "Podpinam configi z repo"

backup_and_link "$DOTFILES_DIR/zsh/.zshrc" \
  "$HOME/.zshrc"

backup_and_link "$DOTFILES_DIR/wezterm/.wezterm.lua" \
  "$HOME/.wezterm.lua"

backup_and_link "$DOTFILES_DIR/vim/init.vim" \
  "$HOME/.config/nvim/init.vim"

backup_and_link "$DOTFILES_DIR/lazygit/config.yml" \
  "$HOME/.config/lazygit/config.yml"

backup_and_link "$DOTFILES_DIR/yazi/yazi.toml" \
  "$HOME/.config/yazi/yazi.toml"

backup_and_link "$DOTFILES_DIR/sway/config" \
  "$HOME/.config/sway/config"

# Ensure Yazi wrapper is loaded even if repo .zshrc does not source it yet.
if [[ -f "$HOME/.zshrc" ]] && ! grep -Fq 'source "$ZSH_CUSTOM/yazi.zsh"' "$HOME/.zshrc"; then
  log "Dodaje ladowanie wrappera Yazi do .zshrc"

  cat >> "$HOME/.zshrc" <<'EOF'

# Yazi cwd wrapper
[ -f "$ZSH_CUSTOM/yazi.zsh" ] && source "$ZSH_CUSTOM/yazi.zsh"
EOF
else
  ok "Wrapper Yazi jest juz ladowany przez .zshrc"
fi

# ============================================================
# DEFAULT SHELL
# ============================================================

log "Ustawiam Zsh jako domyslny shell"

ZSH_BIN="$(command -v zsh)"
CURRENT_SHELL="$(getent passwd "$USER" | cut -d: -f7)"

if [[ "$CURRENT_SHELL" != "$ZSH_BIN" ]]; then
  if chsh -s "$ZSH_BIN"; then
    ok "Domyslny shell zmieniony na $ZSH_BIN"
  else
    warn "chsh nie zadzialal - uzywam usermod przez sudo"
    sudo usermod -s "$ZSH_BIN" "$USER"
  fi
else
  ok "Zsh juz jest domyslnym shellem"
fi

# ============================================================
# SWAY CONFIG VALIDATION
# ============================================================

if [[ -f "$HOME/.config/sway/config" ]] && command -v sway >/dev/null 2>&1; then
  log "Sprawdzam skladnie configu Sway"

  if WLR_BACKENDS=headless \
     WLR_RENDERER=pixman \
     WLR_LIBINPUT_NO_DEVICES=1 \
     sway -C -c "$HOME/.config/sway/config"; then
    ok "Config Sway przeszedl walidacje"
  else
    warn "Sway zglosil problem podczas walidacji configu"
  fi
fi

# ============================================================
# SUMMARY
# ============================================================

printf '\n'
printf '\033[1;32m========================================\033[0m\n'
printf '\033[1;32m GOTOWE\033[0m\n'
printf '\033[1;32m========================================\033[0m\n'
printf '\n'

printf 'Zainstalowane / skonfigurowane:\n'
printf '  - Sway + Fedora Sway session\n'
printf '  - Waybar + swayidle + swaylock + swaybg\n'
printf '  - Rofi (Wayland)\n'
printf '  - CopyQ + wl-clipboard\n'
printf '  - XDG portals: wlr + GTK\n'
printf '  - grim + slurp + swappy\n'
printf '  - brightnessctl + playerctl + pavucontrol\n'
printf '  - Zsh + Oh My Zsh + zsh-autosuggestions\n'
printf '  - WezTerm\n'
printf '  - Neovim\n'
printf '  - Lazygit\n'
printf '  - Yazi + preview dependencies\n'
printf '  - fzf, fd, ripgrep, jq, zoxide itd.\n'
printf '\n'

printf 'Configi sa symlinkami do:\n'
printf '  %s\n' "$DOTFILES_DIR"
printf '\n'

if [[ -d "$BACKUP_ROOT" ]]; then
  printf 'Backup poprzednich configow:\n'
  printf '  %s\n\n' "$BACKUP_ROOT"
fi

printf 'Config Sway w repo powinien byc tutaj:\n'
printf '  %s/sway/config\n\n' "$DOTFILES_DIR"

printf 'Po pierwszej instalacji wyloguj sie i wybierz Sway w GDM.\n'
printf 'Reload configu Sway:\n\n'
printf '  swaymsg reload\n\n'
printf 'Yazi z cd po wyjsciu:\n\n'
printf '  y\n\n'
